        </Option>
      </data_defined_properties>
      <layer enabled="1" class="SimpleLine" pass="0" locked="0">
        <prop k="align_dash_pattern" v="0"/>
        <prop k="capstyle" v="square"/>
        <prop k="customdash" v="5;2"/>
        <prop k="customdash_map_unit_scale" v="3x:0,0,0,0,0,0"/>
